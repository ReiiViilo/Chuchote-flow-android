<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older that API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Défense en profondeur pour les éventuels WAV d'une ancienne version. -->
    <exclude domain="file" path="dictations/" />
    <!-- Les transcriptions et le dictionnaire personnel sont sensibles. -->
    <exclude domain="database" path="." />
    <!-- Un bearer token restauré sur un autre appareil resterait utilisable
         sans nouvelle authentification auprès du relais. -->
    <exclude domain="sharedpref" path="remote_transcription.xml" />
</full-backup-content>
